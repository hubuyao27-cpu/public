{
  "version": "1.0",
  "unit_equivalents": {
    "kJ/mol": ["kJ/mol", "kJ·mol^-1", "kJ·mol^{-1}", "千焦/摩尔"],
    "kcal/mol": ["kcal/mol", "kcal·mol^-1", "千卡/摩尔"],
    "mg/mL": ["mg/mL", "mg/ml", "毫克/毫升"],
    "mg/L": ["mg/L", "毫克/升"],
    "mol/L": ["mol/L", "M", "摩尔/升"],
    "mmol/L": ["mmol/L", "mM", "毫摩尔/升"],
    "m2/g": ["m2/g", "m²/g", "m^{2}/g"],
    "g/cm3": ["g/cm3", "g/cm³", "g/cm^{3}", "g·cm^{-3}"],
    "nm": ["nm", "纳米"],
    "um": ["μm", "um", "微米"],
    "mm": ["mm", "毫米"],
    "cm": ["cm", "厘米"],
    "MPa": ["MPa", "兆帕"],
    "kPa": ["kPa", "千帕"],
    "GPa": ["GPa", "吉帕"],
    "atm": ["atm", "大气压"],
    "eV": ["eV", "电子伏"],
    "K": ["K", "开尔文"],
    "C": ["°C", "℃", "摄氏度"],
    "wt%": ["wt%", "wt.%", "质量分数", "质量百分比"],
    "vol%": ["vol%", "vol.%", "体积分数", "体积百分比"],
    "Hz": ["Hz", "赫兹"],
    "MHz": ["MHz", "兆赫"],
    "h": ["h", "hr", "hrs", "小时"],
    "min": ["min", "mins", "分钟"],
    "s": ["s", "sec", "秒"],
    "%": ["%", "％"]
  },
  "negation_en_patterns": [
    "\\bnot\\b",
    "\\bnever\\b",
    "\\bno\\s+(?:significant|obvious|clear|detectable|observable|evidence|difference)\\b",
    "\\bneither\\b",
    "\\bnor\\b",
    "\\bwithout\\b",
    "\\bunless\\b",
    "\\bexcept\\b",
    "\\bcannot\\b",
    "\\bfail(?:ed|s)?\\s+to\\b",
    "\\babsence\\s+of\\b",
    "\\black(?:s|ed|ing)?\\s+of\\b"
  ],
  "negation_zh_pattern": "(?:不|未|无|非|没|除非|除|不能|未能|并不|绝不|缺乏|缺少|未见|并未|不再)",
  "concession_en_pattern": "\\b(?:however|although|though|whereas|despite|in\\s+spite\\s+of|nevertheless|nonetheless)\\b",
  "concession_zh_pattern": "(?:然而|但是|但|尽管|虽然|虽|不过|却|而|相比之下)",
  "respectively_en_pattern": "\\brespectively\\b",
  "respectively_zh_pattern": "(?:分别|各自|依次)"
}
