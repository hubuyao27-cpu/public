{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CitationPlanPayload",
  "description": "Structured agent decision payload consumed by sync_and_format.py and assemble_deliverables.py.",
  "type": "object",
  "required": [
    "case_id",
    "target_style",
    "in_text_format",
    "manuscript_edits",
    "claim_verifications"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Exact case_id from /app/work/case_plan.json"
    },
    "target_style": {
      "type": "string",
      "enum": [
        "gbt7714_2015_numeric",
        "gbt7714_2015_author_year",
        "apa7",
        "apa6",
        "ieee",
        "nature",
        "vancouver",
        "chicago_author_date"
      ]
    },
    "in_text_format": {
      "type": "string",
      "enum": [
        "bracket",
        "bracket_separate",
        "superscript_bracket",
        "superscript_md",
        "superscript_html",
        "latex_cite",
        "author_year",
        "footnote"
      ]
    },
    "actions_performed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dedup_decisions": {
      "type": "array",
      "description": "Explicit resolution for every Tier-3 ambiguous_duplicate_candidates entry.",
      "items": {
        "type": "object",
        "required": ["candidate_id", "record_ids", "decision", "rationale"],
        "properties": {
          "candidate_id": { "type": "string" },
          "record_ids": { "type": "array", "items": { "type": "string" } },
          "decision": { "type": "string", "enum": ["merge", "keep_separate", "needs_human_confirm"] },
          "canonical_primary": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "metadata_resolutions": {
      "type": "array",
      "description": "Field-level resolutions grounded ONLY in existing raw library records or local evidence PDFs.",
      "items": {
        "type": "object",
        "required": ["ref_id", "field", "value", "source_locator", "rationale"],
        "properties": {
          "ref_id": { "type": "string" },
          "field": { "type": "string" },
          "value": { "type": ["string", "array", "integer", "null"] },
          "source_locator": { "type": "string" },
          "rationale": { "type": "string" },
          "needs_human_confirmation": { "type": "boolean" }
        }
      }
    },
    "manuscript_edits": {
      "type": "array",
      "description": "Sentence-level edits. Embed [[CITE:REF_001]] or [[CITE:REF_001,REF_002]] or [[CITE_NARR:REF_001]] tokens; never hand-number!",
      "items": {
        "type": "object",
        "required": ["sentence_id", "action", "revised_sentence_with_tokens", "anchor_rationale"],
        "properties": {
          "sentence_id": { "type": "string" },
          "action": {
            "type": "string",
            "enum": [
              "keep",
              "insert_citation",
              "relocate_citation",
              "split_cluster_to_clauses",
              "replace_citation",
              "remove_invalid_citation",
              "flag_insufficient_evidence",
              "reorder_section_kept"
            ]
          },
          "revised_sentence_with_tokens": { "type": "string" },
          "old_markers": { "type": "array", "items": { "type": "string" } },
          "target_ref_ids": { "type": "array", "items": { "type": "string" } },
          "anchor_rationale": { "type": "string" }
        }
      }
    },
    "section_order_override": {
      "type": "array",
      "description": "Optional list of section titles/IDs if the task asks to reorder chapters/sections before renumbering.",
      "items": { "type": "string" }
    },
    "claim_verifications": {
      "type": "array",
      "description": "Per-claim support & metadata verification audit.",
      "items": {
        "type": "object",
        "required": ["claim_id", "sentence_id", "cited_ref_ids", "verdict"],
        "properties": {
          "claim_id": { "type": "string" },
          "sentence_id": { "type": "string" },
          "section": { "type": "string" },
          "claim_excerpt": { "type": "string" },
          "cited_ref_ids": { "type": "array", "items": { "type": "string" } },
          "verdict": {
            "type": "string",
            "enum": [
              "supported_by_local_fulltext",
              "supported_by_abstract",
              "title_metadata_only_unverified_claim",
              "claim_mismatch",
              "fabricated_or_dangling_ref",
              "metadata_conflict",
              "insufficient_evidence_in_library"
            ]
          },
          "evidence_locator": { "type": "string" },
          "evidence_quote": { "type": "string" },
          "mismatch_detail": { "type": "string" },
          "needs_human_confirmation": { "type": "boolean" }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "reason", "scope"],
        "properties": {
          "item": { "type": "string" },
          "reason": { "type": "string" },
          "scope": { "type": "string" },
          "recommended_action": { "type": "string" }
        }
      }
    },
    "human_confirmation_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "severity", "location", "question"],
        "properties": {
          "issue_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "important", "recommended"] },
          "location": { "type": "string" },
          "question": { "type": "string" },
          "checked_sources": { "type": "string" }
        }
      }
    },
    "contract_overrides": {
      "type": "object",
      "description": "Explicit values for custom output_contract fields from case.json if needed."
    }
  }
}
